# Copy to .env.local for local work. NEVER commit .env.local or real keys.

# --- Public ---
# Canonical origin, no trailing slash. Production must be the real https domain (used in canonical, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Name shown in the header, titles and footer.
NEXT_PUBLIC_SITE_NAME=AI Tools & Deals
# Set to 1 on staging/preview hosts: every page gets noindex and robots.txt disallows everything.
NOINDEX=

# --- Google Sheets (server-only, never sent to the browser) ---
# Spreadsheet id (between /d/ and /edit in its URL). Share the sheet with the service account as Viewer.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the \n escapes inside the quotes.
GOOGLE_PRIVATE_KEY=
# Seconds between Sheet reads (30-3600, default 300).
SHEET_CACHE_TTL_SECONDS=

# --- Blog byline and "About the author" panel ---
# Default: the site itself is the author (no invented person). Set these to publish under your own name.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_ROLE=
NEXT_PUBLIC_AUTHOR_BIO=

# --- Sheet layout ---
# normalized = the 8-tab AI-directory layout (Settings, Categories, Tools, Tool_Categories, Tool_Alternatives, Deals,
# Blog_Posts, Import_Log; see README). Empty = the original 4-tab layout (Brands, Coupons, Products, Content).
SHEET_LAYOUT=
# 1 = also show rows with publish_status=preview (sample data). Honoured ONLY when the site is not indexable
# (localhost or NOINDEX=1). On a real production domain preview rows are always hidden.
SHOW_PREVIEW_RECORDS=
# Second dev server (npm run dev:preview, port 3401) build folder, so it never touches the main .next.
NEXT_DIST_DIR=

# --- Data source ---
# Empty = Google Sheets when the GOOGLE_* vars are set, otherwise no data (empty states).
# fixture = sample data from tests/fixtures; only honoured when NEXT_PUBLIC_SITE_URL is localhost.
# local-json = normalized workbook JSON at LOCAL_DATA_FILE (absolute path), localhost only (e.g. npm run db:sample).
DATA_SOURCE=
LOCAL_DATA_FILE=

# --- Affiliate redirects ---
# Extra hosts (comma separated) that /go/ may redirect to, besides each brand's own `domain`
# and the built-in list of affiliate networks (src/lib/affiliate.ts).
AFFILIATE_EXTRA_HOSTS=

# --- Admin endpoint ---
# Shared secret for POST /api/revalidate/ (header x-revalidate-secret). 32+ random characters.
REVALIDATE_SECRET=

# --- Contact ---
# Public contact address shown on /contact/. Leave empty if there is none.
CONTACT_EMAIL=
# https endpoint that receives contact-form JSON (e.g. a Google Apps Script web app or a form service).
# Without it the form is not shown.
CONTACT_WEBHOOK_URL=

# --- Conversion analytics (off when empty) ---
# plausible = send page views and three deal events (coupon_impression, copy_code, affiliate_click) to Plausible,
# which sets no cookies. Needs the site registered in Plausible under NEXT_PUBLIC_ANALYTICS_DOMAIN.
# The privacy and cookie pages update themselves when this is set.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# required = ask before counting (small box at the bottom of the page). Empty = count unless the browser sends
# Do Not Track / Global Privacy Control. Decide with your own legal advice for your audience.
NEXT_PUBLIC_ANALYTICS_CONSENT=
